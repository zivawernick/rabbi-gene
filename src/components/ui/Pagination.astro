---
const { page, basePath } = Astro.props
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1)
---
<div class="join flex justify-center mt-8">
  {/* Previous button */}
  <a
        href={page.url.prev}
    class:list={["join-item btn btn-sm", { "btn-disabled": !page.url.prev }]}
  >‹</a>

  {/* Page numbers */}
  {pageNumbers.map((n) => (
    <a
      href={n === 1 ? basePath : `${basePath}/${n}`}
      class:list={["join-item btn btn-sm", { "btn-active": n === page.currentPage }]}
    >{n}</a>
  ))}

  {/* Next button */}
  <a
        href={page.url.next}
    class:list={["join-item btn btn-sm", { "btn-disabled": !page.url.next }]}
  >›</a>
</div>
