---
import WritingsList from '@/components/ui/WritingsList.astro'
import type { PaginateFunction } from 'astro'
import Layout from '@/layouts/Layout.astro'
import { trimExcerpt } from '@/lib/utils'
import { template } from '@/settings'
import { getCollection } from 'astro:content'
import { CATEGORY_SLUGS, CATEGORY_LABELS } from '@/lib/blogCategories'

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
    const blogEntries = await getCollection("blog");

    const mapped = blogEntries
        .map(post => ({
            title: post.data.title,
            date: post.data.date,
            category: post.data.category,
            badge: post.data.topic ?? post.data.category ?? post.data.tags?.[0] ?? 'Uncategorized',
            excerpt: trimExcerpt(post.data.excerpt),
            slug: `${template.base}/blog/${post.id}`,
			draft: post.data.draft || false,
        }))
        .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

    return Object.entries(CATEGORY_SLUGS).flatMap(([label, slug]) => {
        const filtered = mapped.filter(post => post.category === label);
        return paginate(filtered, {
            pageSize: template.postPerPage,
            params: { category: slug },
        });
    });
}

const { page } = Astro.props
const { category } = Astro.params
const categoryLabel = CATEGORY_LABELS[category as string] ?? category
---

<Layout title={`Writings - ${categoryLabel}`}>
	<WritingsList
		page={page}
		activeCategory={category as string}
		basePath={`${template.base}/blog/category/${category}`}
	/>
</Layout>
